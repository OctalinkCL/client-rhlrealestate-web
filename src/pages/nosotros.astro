---
export const prerender = true;

import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import ImageAbout from "@/assets/staff/team.webp";
import PageHeader from "@/components/PageHeader.astro";
import { ClipboardList, Lightbulb, ShieldCheck } from "@lucide/astro";

import { team } from "@/lib/team";

const items = [
  {
    icon: ClipboardList,
    title: "Evaluación",
    subtitle:
      "Nos dedicamos a ofrecer un servicio inmobiliario profesional, formal, simple y transparente.",
  },
  {
    icon: Lightbulb,
    title: "Estrategia",
    subtitle:
      "Combinamos tecnología de punta con un acompañamiento cercano y personalizado.",
  },
  {
    icon: ShieldCheck,
    title: "Seguimiento",
    subtitle:
      "Asesoría clara, segura e informada en cada etapa del proceso de compra, venta o arriendo de propiedades.",
  },
];
---

<Layout>
  <div id="about-page" class="rhl-page">
    <!-- Header -->
    <header
      class="w-full relative overflow-hidden flex pt-20 px-4 pb-10 lg:pt-36 lg:pb-20 bg-primary"
    >
      <!-- * -->
      <div class="absolute inset-0">
        <Image
          src={ImageAbout}
          alt="RHL"
          class="absolute size-full object-cover lg:object-[0%_25%]"
        />
      </div>
      <!-- linear -->
      <div
        class="absolute overflow-hidden inset-0 size-full z-0 bg-linear-to-r from-primary to-transparent"
      >
      </div>
      <!-- inner -->
      <div
        class="container mx-auto z-10 relative overflow-hidden grid gap-6 px-4 lg:px-0"
      >
        <p class="text-white/90 text-sm">NOSOTROS</p>
        <div class="border-t border-white/30"></div>
        <div class="grid gap-3.5 lg:max-w-3xl">
          <h1 class="font-display text-5xl text-white lg:text-6xl">
            Un equipo <span
              class="font-display italic font-semibold tracking-tight"
              >comprometido</span
            >. Un proceso <span
              class="font-display italic font-semibold tracking-tight"
              >confiable</span
            >
          </h1>
          <p class="text-lg text-white">
            Nuestro equipo de brokers altamente capacitados y con profundo
            conocimiento del mercado, entrega asesoría clara, segura e informada
            en cada etapa del proceso de compra, venta o arriendo de
            propiedades.
          </p>
        </div>
      </div>
    </header>

    <!--  -->
    <section class="py-16 lg:py-20">
      <div class="container mx-auto px-4 lg:px-0">
        <ul class="grid gap-2 lg:grid-cols-3 lg:gap-6">
          {
            items.map((item) => (
              <li class="grid gap-4 bg-white p-8 rounded-lg lg:p-6">
                <item.icon stroke-width="1" class="text-primary" size={36} />
                <h3 class="text-xl lg:text-2xl">{item.title}</h3>
                <p class="text-gray-500 text-sm">{item.subtitle}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Teams -->
    <section class="py-12 lg:py-16">
      <div class="container mx-auto px-4 lg:px-0 grid gap-10">
        <!-- Header -->
        <div class="max-w-4xl flex justify-center mx-auto">
          <PageHeader
            tagLabel="Nuestros Equipo"
            title="Conozca a los expertos que guían cada movimiento"
            subtitle="Combinanamos conocimiento del mercado, experiencia y conocimiento local para ayudar a los clientes a encontrar propiedades con confianza."
          />
        </div>
        <!-- Team list -->
        <div>
          <ul class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
            {
              team.map((t) => (
                <li class="bg-white overflow-hidden rounded-xl">
                  <div class="h-60 lg:h-87 w-full overflow-hidden">
                    <Image
                      src={t.image}
                      alt={t.name}
                      class=" size-full object-cover object-top "
                    />
                  </div>
                  <div class="grid p-4">
                    <h3 class="text-lg">{t.name}</h3>
                    <p class="text-gray-500 text-sm">{t.role}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  </div>
</Layout>
