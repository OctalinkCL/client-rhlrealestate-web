---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { findProperty } from "@/lib/easybroker";
import { setCacheHeaders } from "@/lib/cache";

import PropertyGallery from "@/components/detail/PropertyGallery.astro";

const { id = "" } = Astro.params;

// Los IDs de EasyBroker tienen la forma "EB-XXXX".
// Si la URL no calza, respondemos 404 sin gastar una llamada a la API.
const property = /^EB-[A-Z0-9]+$/i.test(id) ? await findProperty(id) : null;

if (!property) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

setCacheHeaders(Astro.response, 300);
---

<Layout>
  <!-- page -->
  <div class="pt-15 mx-4 lg:pt-20 lg:mx-0">
    <!-- container -->
    <div class="container mx-auto max-w-6xl">
      <!-- header -->
      <header class="py-4">
        <button>dsdklslkds</button>
      </header>
      <!-- cover -->
      <section>
        <PropertyGallery images={property.property_images} />
      </section>
      <!-- content -->
      <div class="grid lg:gap-8 lg:grid-cols-[360px_1fr]">
        <!-- aside -->
        <aside class="lg:sticky lg:top-30 lg:self-start">
          <ul>
            <li>Datos generales</li>
            <li>Ubicación</li>
            <li>Características</li>
            <li>Distribución</li>
            <li>Amenidades</li>
            <li>Precio</li>
          </ul>
        </aside>
        <!-- information -->
        <div>Content</div>
      </div>
    </div>

    <pre
      class="bg-white_ rounded-xl p-4 text-xs overflow-auto">{JSON.stringify(property, null, 2)}</pre>
  </div>
</Layout>
