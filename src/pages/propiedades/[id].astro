---
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import { findProperty } from "@/lib/easybroker";
import { setCacheHeaders } from "@/lib/cache";

import PropertyGallery from "@/components/detail/PropertyGallery.astro";

import { ChevronLeft, Share2 } from "@lucide/astro";

const { id = "" } = Astro.params;

// Los IDs de EasyBroker tienen la forma "EB-XXXX".
// Si la URL no calza, respondemos 404 sin gastar una llamada a la API.
const property = /^EB-[A-Z0-9]+$/i.test(id) ? await findProperty(id) : null;

if (!property) {
  return new Response(null, { status: 404, statusText: "Not found" });
}

setCacheHeaders(Astro.response, 300);
---

<Layout>
  <!-- page -->
  <div class="pt-15 mx-4 lg:pt-20 lg:mx-0">
    <!-- header: sticky bajo el header principal, fondo a todo el ancho -->
    <header
      class="sticky top-(--header-height) z-10 -mx-4 px-4 bg-[#f7f7f7] lg:top-(--header-height-lg) lg:mx-0 lg:px-0"
    >
      <div
        class="container mx-auto max-w-6xl py-4 flex items-center justify-between text-xs lg:py-6"
      >
        <a
          href="/propiedades"
          data-back
          class="flex items-center gap-1 hover:underline"
        >
          <ChevronLeft size={18} />
          Volver
        </a>
        <button
          type="button"
          data-share
          class="flex items-center gap-1 cursor-pointer hover:underline"
        >
          <Share2 size={18} />
          <span data-share-label>Compartir</span>
        </button>
      </div>
    </header>

    <!-- container -->
    <div class="container mx-auto max-w-6xl">
      <!-- cover -->
      <section>
        <PropertyGallery images={property.property_images} title={property.title} />
      </section>
      <!-- content -->
      <div class="grid lg:gap-8 lg:grid-cols-[1fr_360px]">
        <!-- information -->
        <div>Content</div>
        <!-- aside -->
        <aside class="lg:sticky lg:top-40 lg:self-start">
          <ul>
            <li>Datos generales</li>
            <li>Ubicación</li>
            <li>Características</li>
            <li>Distribución</li>
            <li>Amenidades</li>
            <li>Precio</li>
          </ul>
        </aside>
      </div>
    </div>

    <pre
      class="bg-white_ rounded-xl p-4 text-xs overflow-auto">{JSON.stringify(property, null, 2)}</pre>
  </div>

  <!-- barra inferior fija (solo mobile) -->
  <div
    class="fixed inset-x-0 bottom-0 z-20 bg-white shadow-[0_-4px_12px_rgba(0,0,0,0.08)] px-4 pt-4 pb-[calc(1rem+env(safe-area-inset-bottom))] lg:hidden"
  >
    <p class="text-center">Hola mundo</p>
  </div>
</Layout>

<style is:global>
  /* Reserva espacio para la barra fija inferior en mobile,
     así no tapa el final del footer del sitio. */
  @media (max-width: 1023px) {
    body {
      padding-bottom: calc(4rem + env(safe-area-inset-bottom));
    }
  }
</style>

<script>
  // Volver: si venimos del listado, retrocedemos en el historial
  // para conservar los filtros que el usuario tenía en la URL.
  const backLink = document.querySelector<HTMLAnchorElement>("[data-back]");
  backLink?.addEventListener("click", (e) => {
    const referrer = document.referrer ? new URL(document.referrer) : null;
    const fromListing =
      referrer?.origin === location.origin &&
      referrer.pathname.startsWith("/propiedades") &&
      history.length > 1;

    if (fromListing) {
      e.preventDefault();
      history.back();
    }
  });

  // Compartir: copia el link de la propiedad al portapapeles
  const shareBtn = document.querySelector<HTMLButtonElement>("[data-share]");
  const shareLabel = shareBtn?.querySelector("[data-share-label]");
  shareBtn?.addEventListener("click", async () => {
    if (!shareLabel) return;
    try {
      await navigator.clipboard.writeText(location.href);
      shareLabel.textContent = "¡Link copiado!";
    } catch {
      shareLabel.textContent = "No se pudo copiar";
    }
    setTimeout(() => (shareLabel.textContent = "Compartir"), 2000);
  });
</script>
