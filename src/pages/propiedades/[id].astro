---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getProperty } from "../../lib/easybroker";
import { setCacheHeaders } from "../../lib/cache";
// Icons
import { MapPin, Pin, Bed, Bath, Ruler } from "@lucide/astro";

// Components
import Bento from "../../components/detail/Bento.astro";
import Badge from "@/components/ui/Badge.astro";

setCacheHeaders(Astro.response);
const { id } = Astro.params;
const property = await getProperty(id!);

const operationType =
  property.operations?.[0]?.type === "rental" ? "En Arriendo" : "En Venta";

function toYouTubeEmbedUrl(url: string): string | null {
  try {
    const parsed = new URL(url);
    const videoId =
      parsed.searchParams.get("v") ||
      (parsed.hostname === "youtu.be" ? parsed.pathname.slice(1) : null);
    return videoId ? `https://www.youtube.com/embed/${videoId}` : null;
  } catch {
    return null;
  }
}

const videoEmbedUrl = property.videos?.[0]
  ? toYouTubeEmbedUrl(property.videos[0])
  : null;
---

<Layout>
  <div class="rhl-page">
    <div
      class="container mx-auto px-4 lg:px-0 grid gap-6 pt-6 | lg:gap-12 lg:pt-12"
    >
      <!-- Bento -->
      <Bento images={property.property_images.slice(0, 4)} />

      <!-- Content -->
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 lg:gap-9">
        <!-- Aside -->
        <aside
          class="col-span-1 lg:col-span-2 lg:sticky lg:top-30 lg:self-start"
        >
          <!-- Primary Data -->
          <div>
            <div class="grid">
              <p
                class="text-gray-600 flex items-center gap-2 text-sm lg:text-base"
              >
                <Pin size={16} />
                {operationType}
              </p>
              <p
                class="text-gray-600 flex items-center gap-2 text-sm lg:text-base"
              >
                <MapPin size={16} />
                {property.location?.name}
              </p>
              <h1 class="font-display text-2xl lg:text-4xl">
                {property.title}
              </h1>
              <p class="text-sm text-gray-600 mt-2">ID: {property.public_id}</p>
            </div>
            <ul
              class="grid grid-cols-3 border-t border-gray-200 my-4 py-4 gap-3"
            >
              <li class="bg-taupe-200/60 p-3 rounded-lg grid gap-2">
                <Bed size={27} stroke-width={1.5} class="text-taupe-700" />
                <span
                  class="text-gray-600 whitespace-nowrap overflow-hidden text-ellipsis"
                >
                  {property.bedrooms} Dormitorios</span
                >
              </li>
              <li class="bg-taupe-200/60 p-3 rounded-lg grid gap-2">
                <Bath size={27} stroke-width={1.5} class="text-taupe-700" />
                <span class="text-gray-600">{property.bathrooms} Baños</span>
              </li>
              <li class="bg-taupe-200/60 p-3 rounded-lg grid gap-2">
                <Ruler size={27} stroke-width={1.5} class="text-taupe-700" />
                {property.construction_size}
              </li>
            </ul>
          </div>
        </aside>

        <!-- Main -->
        <div class="col-span-1 lg:col-span-3">
          <!-- Card -->
          <div class="bg-white rounded-xl p-4 grid gap-9">
            <!-- Description -->
            <section class="grid gap-3">
              <h4 class="font-display text-2xl">Detalles generales</h4>
              <p class="whitespace-pre-wrap">{property.description}</p>
            </section>

            <!-- Features -->
            <section class="grid gap-3">
              <h4 class="font-display text-2xl">Características</h4>
              <div class="flex flex-wrap gap-2">
                {
                  property.features?.map((feature) => (
                    <Badge class="bg-taupe-100 text-taupe-800 text-sm!">
                      {feature.name}
                    </Badge>
                  ))
                }
              </div>
            </section>

            <!-- Video -->
            {
              videoEmbedUrl && (
                <section class="grid gap-3">
                  <h4 class="font-display text-2xl">Video</h4>
                  <iframe
                    class="w-full aspect-video"
                    src={videoEmbedUrl}
                    title="YouTube video player"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  />
                </section>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
