---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { getProperties } from "../../lib/easybroker";

const page      = Number(Astro.url.searchParams.get("page") ?? 1);
const operacion = Astro.url.searchParams.get("operacion") ?? "";
const tipo      = Astro.url.searchParams.get("tipo") ?? "";
const ubicacion = Astro.url.searchParams.get("ubicacion") ?? "";

// Si hay filtro de operacion, pedimos el maximo para filtrar todo de una vez
const limit = operacion ? 50 : 20;

const data = await getProperties({
  page: operacion ? 1 : page,
  limit,
  "search[statuses][]": "published",
  ...(tipo      && { "search[property_types][]": tipo }),
  ...(ubicacion && { "search[city]": ubicacion }),
});

const properties = operacion
  ? data.content.filter((p) => p.operations.some((op) => op.type === operacion))
  : data.content;

const showPagination = !operacion;
---

<Layout>
  <h1>Propiedades</h1>
  <p>Total: {properties.length}</p>

  <ul>
    {properties.map((prop) => (
      <li>
        <a href={`/propiedades/${prop.public_id}`}>
          <span>{prop.title}</span>
          <span>--{prop.operations.map((op) => op.type)}--</span>
          <span>{prop.location}</span>
        </a>
      </li>
    ))}
  </ul>

  {showPagination && (
    <div>
      {page > 1 && (
        <a href={`?page=${page - 1}&tipo=${tipo}&ubicacion=${ubicacion}`}>Anterior</a>
      )}
      {data.pagination.next_page && (
        <a href={`?page=${page + 1}&tipo=${tipo}&ubicacion=${ubicacion}`}>Siguiente</a>
      )}
    </div>
  )}
</Layout>
