---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Buscador from "../../components/Buscador.astro";
import { getProperties, getLocations } from "../../lib/easybroker";

const PER_PAGE = 9;

const page = Number(Astro.url.searchParams.get("page") ?? 1);
const operacion = Astro.url.searchParams.get("operacion") ?? "";
const tipo = Astro.url.searchParams.get("tipo") ?? "";
const ubicacion = Astro.url.searchParams.get("ubicacion") ?? "";

const [data, { localities }] = await Promise.all([
  getProperties({ page: 1, limit: 50, "search[statuses][]": "published" }),
  getLocations(),
]);

const filtered = data.content
  .filter((p) => !operacion || p.operations.some((op) => op.type === operacion))
  .filter((p) => !tipo || p.property_type === tipo)
  .filter(
    (p) =>
      !ubicacion ||
      (typeof p.location === "string"
        ? p.location.toLowerCase().includes(ubicacion.toLowerCase())
        : false),
  );

const totalPages = Math.ceil(filtered.length / PER_PAGE);
const properties = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);

const params = `&operacion=${operacion}&tipo=${tipo}&ubicacion=${ubicacion}`;
---

<Layout>
  <div id="properties" class="bg-neutral-100">
    <header class="bg-blue-100">
      <h1>Propiedades</h1>
      <p>{filtered.length} propiedades — página {page} de {totalPages}</p>
      <Buscador localities={localities} operacion={operacion} tipo={tipo} ubicacion={ubicacion} />
    </header>

    <div class="container mx-auto">
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {
          properties.map((prop) => (
            <a href={`/propiedades/${prop.public_id}`} class="group">
              <div class="bg-white rounded-lg p-2">
                {/* image */}
                <div class="relative w-full overflow-hidden">
                  <img
                    class="rounded w-full object-cover aspect-video group-hover:scale-105 transition-all duration-300 ease-in-out"
                    src={prop.title_image_full}
                    alt={prop.title}
                  />

                  <div class="absolute top-0 left-0 p-2 flex gap-2">
                    <span class="bg-white rounded px-2 py-1 text-xs font-semibold">
                      {prop.operations.map((op) => op.type)}
                    </span>
                    <span class="bg-white rounded px-2 py-1 text-xs font-semibold">
                      {prop.property_type}
                    </span>
                  </div>
                </div>
                <p class="font-bold">{prop.title}</p>
                <p>{prop.location}</p>
              </div>
            </a>
          ))
        }
      </div>

      <div>
        {page > 1 && <a href={`?page=${page - 1}${params}`}>Anterior</a>}
        {
          page < totalPages && (
            <a href={`?page=${page + 1}${params}`}>Siguiente</a>
          )
        }
      </div>
    </div>
  </div>
</Layout>
