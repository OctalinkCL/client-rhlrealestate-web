---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Buscador from "../../components/Buscador.astro";
import { getProperties, getLocations } from "../../lib/easybroker";
import { setCacheHeaders } from "../../lib/cache";
import PropertyCard from "../../components/PropertyCard.astro";

import Badge from "@/components/ui/Badge.astro";

// Icon
import { ArrowLeft, ArrowRight } from "@lucide/astro";

setCacheHeaders(Astro.response);

const PER_PAGE = 9;

const page = Number(Astro.url.searchParams.get("page") ?? 1);
const operacion = Astro.url.searchParams.get("operacion") ?? "";
const tipo = Astro.url.searchParams.get("tipo") ?? "";
const ubicacion = Astro.url.searchParams.get("ubicacion") ?? "";
const orden = Astro.url.searchParams.get("orden") ?? "updated_at-desc";

const sortServer = orden.startsWith("updated_at") ? orden : "updated_at-desc";

const [data, { localities }] = await Promise.all([
  getProperties({
    page: 1,
    limit: 50,
    "search[statuses][]": "published",
    "search[sort_by]": sortServer,
  }),
  getLocations(),
]);

let filtered = data.content
  .filter((p) => !operacion || p.operations.some((op) => op.type === operacion))
  .filter((p) => !tipo || p.property_type === tipo)
  .filter((p) => {
    if (!ubicacion) return true;
    const loc = p.location;
    if (!loc) return false;
    const haystack = [loc.name, loc.street]
      .filter(Boolean)
      .join(" ")
      .toLowerCase();
    return haystack.includes(ubicacion.toLowerCase());
  });

// Orden por precio client-side
if (orden === "price-asc") {
  filtered = filtered.sort(
    (a, b) => (a.operations[0]?.amount ?? 0) - (b.operations[0]?.amount ?? 0),
  );
} else if (orden === "price-desc") {
  filtered = filtered.sort(
    (a, b) => (b.operations[0]?.amount ?? 0) - (a.operations[0]?.amount ?? 0),
  );
}

const totalPages = Math.ceil(filtered.length / PER_PAGE);
const properties = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);

const params = `&operacion=${operacion}&tipo=${tipo}&ubicacion=${ubicacion}&orden=${orden}`;

const ORDEN_OPCIONES = [
  { value: "updated_at-desc", label: "Últimos anuncios" },
  { value: "updated_at-asc", label: "Anuncios más antiguos" },
  { value: "price-asc", label: "Precio (de menor a mayor)" },
  { value: "price-desc", label: "Precio (de mayor a menor)" },
];
---

<Layout>
  <div id="properties" class="rhl-page">
    <!-- Header -->
    <header class="bg-rhl-soft-blue py-9 lg:py-12">
      <div class="container mx-auto px-4 lg:px-0 grid gap-4 lg:gap-12">
        <div>
          <span class="uppercase text-xs font-medium opacity-60"
            >Nuestra Oferta</span
          >
          <h1 class="font-display text-2xl lg:text-4xl">
            Encuentra la propiedad que buscas
          </h1>
        </div>

        <div class="bg-white p-3 rounded-2xl">
          <Buscador
            localities={localities}
            operacion={operacion}
            tipo={tipo}
            ubicacion={ubicacion}
          />
        </div>
      </div>
    </header>

    <div
      class="container mx-auto px-4 pt-6 pb-9 lg:pt-9 lg:pb-12 lg:px-0 grid gap-6"
    >
      <!-- Order -->
      <div class="flex justify-between items-center">
        <Badge class="bg-white px-3 py-2">
          <span>{filtered.length} propiedades</span>
        </Badge>

        <select
          id="orden-select"
          class="rounded-full text-sm px-3 py-2 bg-white outline-none"
          onchange={`window.location.href='?page=1&operacion=${operacion}&tipo=${tipo}&ubicacion=${ubicacion}&orden='+this.value`}
        >
          {
            ORDEN_OPCIONES.map((op) => (
              <option value={op.value} selected={op.value === orden}>
                {op.label}
              </option>
            ))
          }
        </select>
      </div>

      <!-- Properties -->
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {properties.map((prop) => <PropertyCard property={prop} />)}
      </div>

      <!-- Pagination -->
      <div class="grid grid-cols-3 items-center">
        <div class="flex items-start">
          {
            page > 1 && (
              <a
                class="bg-white flex items-center text-sm font-medium px-3 py-2 rounded-full shadow-sm gap-2 hover:shadow-md transition-shadow"
                href={`?page=${page - 1}${params}`}
              >
                <ArrowLeft size={16} />
                <span>Anterior</span>
              </a>
            )
          }
        </div>

        <Badge class="bg-white px-3 py-2 mx-auto">
          <span>Página {page} de {totalPages}</span>
        </Badge>

        <div class="flex justify-end">
          {
            page < totalPages && (
              <a
                class="bg-white flex items-center text-sm font-medium px-3 py-2 rounded-full shadow-sm gap-2 hover:shadow-md transition-shadow"
                href={`?page=${page + 1}${params}`}
              >
                <span>Siguiente</span>
                <ArrowRight size={16} />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</Layout>
