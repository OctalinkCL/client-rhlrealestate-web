---
interface Props {
  tagLabel: string;
  title: string;
  subtitle: string;
}
const { tagLabel, title, subtitle } = Astro.props as Props;
---

<header class="flex flex-col gap-2 w-full items-center text-center lg:gap-3">
  <!-- Title -->
  <div class="w-full grid gap-3">
    <div class="flex w-full justify-center gap-4 items-center">
      <span class="h-px bg-black/10 flex-1"></span>
      <span class="whitespace-nowrap text-neutral-500 text-xs lg:text-sm">
        {tagLabel}
      </span>
      <span class="h-px bg-black/10 flex-1"></span>
    </div>
    <h2 class="font-display text-3xl lg:text-[53px]">{title}</h2>
  </div>
  <!-- Subtitle -->
  {
    subtitle && (
      <div class="max-w-[480px]">
        <p class="text-xs lg:text-base">{subtitle}</p>
      </div>
    )
  }
</header>
