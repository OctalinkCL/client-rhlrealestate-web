---
import type { Property } from "../lib/easybroker";
import Logo from "./Logo.astro";
import { Bed, Bath, RulerDimensionLine, ArrowRight } from "@lucide/astro";

import Badge from "@/components/ui/Badge.astro";

interface Props {
  property: Property;
}

const { property } = Astro.props;

const link = `/propiedades/${property.public_id}`;

const operationType = (type: string) => {
  return type === "sale" ? "En Venta" : "En Arriendo";
};
---

<div class="bg-white p-3 grid gap-5 rounded-4xl group hover:shadow">
  <!-- Image -->
  <a
    href={link}
    class="relative bg-neutral-200 rounded-3xl overflow-hidden aspect-3/2"
  >
    {
      property.title_image_full ? (
        <img
          src={property.title_image_full}
          alt={property.title}
          class="size-full object-cover group-hover:scale-105 transition-transform duration-300 ease-in-out"
        />
      ) : (
        <Logo class="w-50 opacity-30" />
      )
    }

    <div class="absolute top-4 left-4">
      <Badge class="bg-white text-black">
        {property.operations.map((op) => operationType(op.type))}
      </Badge>
    </div>
  </a>

  <div class="flex flex-col h-full place-content-between gap-5 px-3 pb-3">
    <div class="grid gap-3.5">
      <div class="flex items-center gap-1">
        {
          property.bedrooms && (
            <Badge class="bg-taupe-100 text-neutral-600 text-sm!">
              <Bed class="h-4 w-4" />
              {property.bedrooms} Dorm.
            </Badge>
          )
        }
        {
          property.bathrooms && (
            <Badge class="bg-taupe-100 text-neutral-600 text-sm!">
              <Bath class="h-4 w-4" />
              {property.bathrooms} Baños
            </Badge>
          )
        }
        {
          property.construction_size && (
            <Badge class="bg-taupe-100 text-neutral-600 text-sm!">
              <RulerDimensionLine class="h-4 w-4" />
              {property.construction_size} m²
            </Badge>
          )
        }
      </div>
      <div class="grid gap-1">
        <a href={link} class="text-lg group-hover:text-blue-900 hover:underline font-medium"
          >{property.title}</a
        >
        <p class="text-sm">{property.location}</p>
      </div>
    </div>
    <a
      href={link}
      class="bg-taupe-200 flex items-center justify-between p-1 rounded-full | group-hover:bg-primary group-hover:text-white transition-colors duration-300 ease-in-out"
    >
      <span class="text-sm px-3 font-medium">Ver Propiedad</span>
      <div
        class="size-9 rounded-full bg-white flex items-center justify-center text-black"
      >
        <ArrowRight
          class="h-4 w-4 group-hover:-rotate-45 transition-transform duration-300 ease-in-out"
        />
      </div>
    </a>
  </div>
</div>
