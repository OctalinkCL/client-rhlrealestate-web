---
const tiposPropiedad = [
  "Casa",
  "Departamento",
  "Terreno",
  "Parcela",
  "Estacionamiento",
  "Hotel",
  "Cabaña",
];

const modalidades = ["Venta", "Arriendo", "Compra"];
---

<form id="contact-form" novalidate>
  <div class="grid gap-4">
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="grid gap-1.5">
        <label for="cf-nombre" class="text-sm font-medium">Nombre</label>
        <input
          id="cf-nombre"
          name="nombre"
          type="text"
          placeholder="Tu nombre"
          required
          class="border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black/20"
        />
      </div>

      <div class="grid gap-1.5">
        <label for="cf-email" class="text-sm font-medium">Email</label>
        <input
          id="cf-email"
          name="email"
          type="email"
          placeholder="tu@email.com"
          required
          class="border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black/20"
        />
      </div>
    </div>

    <div class="grid gap-1.5">
      <label for="cf-telefono" class="text-sm font-medium">Teléfono</label>
      <div class="flex items-center border rounded-md overflow-hidden focus-within:ring-2 focus-within:ring-black/20">
        <span class="px-3 py-2 text-sm bg-gray-50 border-r text-gray-500 select-none">+56</span>
        <input
          id="cf-telefono"
          name="telefono"
          type="tel"
          placeholder="9 1234 5678"
          required
          class="flex-1 px-3 py-2 text-sm focus:outline-none"
        />
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div class="grid gap-1.5">
        <label for="cf-tipo" class="text-sm font-medium">Tipo de propiedad</label>
        <select
          id="cf-tipo"
          name="tipo"
          required
          class="border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black/20"
        >
          <option value="">Selecciona un tipo</option>
          {tiposPropiedad.map((t) => <option value={t}>{t}</option>)}
        </select>
      </div>

      <div class="grid gap-1.5">
        <label for="cf-modalidad" class="text-sm font-medium">Modalidad</label>
        <select
          id="cf-modalidad"
          name="modalidad"
          required
          class="border rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-black/20"
        >
          <option value="">Selecciona una modalidad</option>
          {modalidades.map((m) => <option value={m}>{m}</option>)}
        </select>
      </div>
    </div>

    <p id="cf-error" class="text-sm text-red-600 hidden"></p>

    <button
      type="submit"
      id="cf-submit"
      class="bg-black text-white text-sm font-medium rounded-md px-5 py-2.5 hover:bg-black/80 transition-colors disabled:opacity-50"
    >
      Enviar mensaje
    </button>

    <p id="cf-success" class="text-sm text-green-700 hidden">
      Mensaje enviado. Te contactaremos pronto.
    </p>
  </div>
</form>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submit = document.getElementById("cf-submit") as HTMLButtonElement;
  const error = document.getElementById("cf-error") as HTMLParagraphElement;
  const success = document.getElementById("cf-success") as HTMLParagraphElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    error.classList.add("hidden");
    success.classList.add("hidden");

    const data = Object.fromEntries(new FormData(form));

    if (!data.nombre || !data.email || !data.telefono || !data.tipo || !data.modalidad) {
      error.textContent = "Por favor completa todos los campos.";
      error.classList.remove("hidden");
      return;
    }

    submit.disabled = true;
    submit.textContent = "Enviando…";

    try {
      const res = await fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        form.reset();
        success.classList.remove("hidden");
      } else {
        error.textContent = "Ocurrió un error. Intenta nuevamente.";
        error.classList.remove("hidden");
      }
    } catch {
      error.textContent = "Ocurrió un error. Intenta nuevamente.";
      error.classList.remove("hidden");
    } finally {
      submit.disabled = false;
      submit.textContent = "Enviar mensaje";
    }
  });
</script>
