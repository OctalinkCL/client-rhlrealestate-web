---
import { Image } from "astro:assets";
import { MessageSquareText, X } from "@lucide/astro";
import IconWhatsapp from "../../assets/icon_whatsapp_white.svg";
import { propertyWhatsappHref } from "@/lib/contact";
import RequestContact from "./RequestContact.astro";
import type { Operation } from "@/lib/easybroker";

interface Props {
  title: string;
  publicId: string;
  operations: Operation["type"][];
}

const { publicId, operations } = Astro.props;
const whatsappHref = propertyWhatsappHref(Astro.props);
---

<!-- Barra de contacto fija inferior (solo mobile) -->
<div
  class="fixed inset-x-0 bottom-0 z-20 grid grid-cols-2 gap-3 bg-white px-4 pt-4 pb-[calc(1rem+env(safe-area-inset-bottom))] shadow-[0_-4px_12px_rgba(0,0,0,0.08)] lg:hidden"
>
  <button
    type="button"
    data-request-contact-open
    class="flex cursor-pointer items-center justify-center gap-2 rounded-full bg-rhl-sand py-3.5 text-sm font-medium text-neutral-900 transition-colors active:bg-rhl-sand-dark"
  >
    <MessageSquareText size={18} />
    Me interesa
  </button>
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="flex items-center justify-center gap-2 rounded-full bg-neutral-900 py-3.5 text-sm font-medium text-white transition-colors active:bg-neutral-700"
  >
    <Image class="w-4.5 h-4.5 shrink-0" src={IconWhatsapp} alt="" />
    WhatsApp
  </a>
</div>

<!-- Bottom sheet con el formulario de lead (mobile) -->
<dialog
  data-request-contact-dialog
  aria-labelledby="request-contact-title"
  class="mx-0 mt-auto mb-0 max-h-[90dvh] w-full max-w-none overflow-y-auto overscroll-contain rounded-t-3xl border-0 bg-white p-0 text-neutral-900 transition-transform duration-300 backdrop:bg-black/40 starting:open:translate-y-full"
>
  <div class="p-6 pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
    <div class="mb-5 flex items-start justify-between gap-4">
      <div>
        <h2 id="request-contact-title" class="text-2xl font-semibold tracking-tight">
          ¿Te interesa esta propiedad?
        </h2>
        <p class="mt-1 text-sm text-neutral-600">
          Déjanos tus datos y te contactamos.
        </p>
      </div>
      <button
        type="button"
        data-request-contact-close
        autofocus
        aria-label="Cerrar"
        class="flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-full bg-neutral-100 transition-colors hover:bg-neutral-200"
      >
        <X size={20} />
      </button>
    </div>

    <RequestContact publicId={publicId} operations={operations} />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>(
    "[data-request-contact-dialog]",
  );

  if (dialog) {
    document
      .querySelector("[data-request-contact-open]")
      ?.addEventListener("click", () => {
        dialog.showModal();
        // El dialog no bloquea el scroll de la página por sí solo
        document.documentElement.style.overflow = "hidden";
      });

    dialog.addEventListener("close", () => {
      document.documentElement.style.overflow = "";
    });

    // Click en el backdrop cierra el sheet
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog
      .querySelector("[data-request-contact-close]")
      ?.addEventListener("click", () => dialog.close());
  }
</script>
