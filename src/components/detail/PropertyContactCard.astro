---
import { Image } from "astro:assets";
import IconWhatsapp from "../../assets/icon_whatsapp_white.svg";
import { propertyWhatsappHref } from "@/lib/contact";
import RequestContact from "./RequestContact.astro";
import type { Operation } from "@/lib/easybroker";

interface Props {
  title: string;
  publicId: string;
  operations: Operation["type"][];
}

const { publicId, operations } = Astro.props;
const whatsappHref = propertyWhatsappHref(Astro.props);
---

<div class="rounded-3xl bg-white p-6">
  <h2 class="text-2xl font-semibold tracking-tight">Conversemos</h2>
  <p class="mt-2 text-sm text-neutral-600">
    Coordinemos una visita o resolvemos tus dudas.
  </p>

  <!-- WhatsApp -->
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-5 flex items-center justify-center gap-2 rounded-full bg-neutral-900 px-6 py-4 text-sm font-medium text-white transition-colors hover:bg-neutral-700"
  >
    <Image class="w-5 h-5 shrink-0" src={IconWhatsapp} alt="" />
    Escríbenos por WhatsApp
  </a>

  <div class="my-5 flex items-center gap-3 text-xs text-neutral-500">
    <span class="h-px flex-1 bg-neutral-200"></span>
    o déjanos tus datos
    <span class="h-px flex-1 bg-neutral-200"></span>
  </div>

  <RequestContact publicId={publicId} operations={operations} />
</div>
