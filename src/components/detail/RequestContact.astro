---
import { Pencil } from "@lucide/astro";
import {
  LEAD_OPERATIONS,
  LEAD_QUESTIONS,
  type LeadOperation,
} from "@/lib/contact";
import type { Operation } from "@/lib/easybroker";

interface Props {
  publicId: string;
  operations: Operation["type"][];
}

const { publicId, operations } = Astro.props;

// Cualquier operación que no sea venta (p. ej. arriendo temporal) cuenta como arriendo.
// Si la propiedad tiene ambas (o ninguna), primero preguntamos qué busca.
const found = [
  ...new Set(operations.map((type) => (type === "sale" ? "sale" : "rental"))),
] as LeadOperation[];
const choices: LeadOperation[] = found.length ? found : ["sale", "rental"];
const askOperation = choices.length > 1;

// Dos pasos: 1) todas las preguntas + "Continuar"  2) datos de contacto.
// Al mostrarse (display: none → visible) cada bloque entra con un fundido.
const fadeIn = "transition-opacity duration-300 starting:opacity-0";
const legend = "text-sm font-medium text-neutral-900";
const chip =
  "cursor-pointer rounded-full bg-neutral-100 px-4 py-3 text-sm font-medium lg:px-3.5 lg:py-2 lg:text-xs text-neutral-700 transition-colors not-has-checked:hover:bg-neutral-200 has-checked:bg-neutral-900 has-checked:text-white has-focus-visible:ring-2 has-focus-visible:ring-neutral-900/30";
const field =
  "h-12 w-full rounded-2xl bg-neutral-100 px-4 text-base outline-none lg:text-sm transition-shadow placeholder:text-neutral-400 focus:ring-2 focus:ring-neutral-900/20";
const primary =
  "flex h-12 cursor-pointer items-center justify-center rounded-full bg-rhl-sand px-6 text-sm font-medium text-neutral-900 transition-colors hover:bg-rhl-sand-dark disabled:cursor-wait disabled:opacity-50";
---

<!-- Formulario de lead → /api/lead → EasyBroker contact_requests.
     Puede aparecer más de una vez por página: el script usa data-attributes, no ids. -->
<form data-request-contact novalidate class="grid gap-5">
  <input type="hidden" name="property_id" value={publicId} />
  <!-- Honeypot anti-bots -->
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    class="hidden"
  />
  {!askOperation && <input type="hidden" name="operation" value={choices[0]} />}

  <!-- Paso 1: preguntas de calificación -->
  {
    askOperation && (
      <fieldset data-question>
        <legend class={legend}>¿Qué buscas?</legend>
        <div class="mt-2 flex flex-wrap gap-2">
          {choices.map((op) => (
            <label class={chip}>
              <input type="radio" name="operation" value={op} class="sr-only" />
              {LEAD_OPERATIONS[op]}
            </label>
          ))}
        </div>
      </fieldset>
    )
  }

  <!-- Si hay que elegir operación, sus preguntas aparecen al elegirla -->
  {
    choices.map((op) =>
      LEAD_QUESTIONS[op].map((question) => (
        <fieldset
          data-question
          data-operation={op}
          disabled={askOperation}
          hidden={askOperation}
          class={fadeIn}
        >
          <legend class={legend}>{question.label}</legend>
          <div class="mt-2 flex flex-wrap gap-2">
            {question.options.map((option) => (
              <label class={chip}>
                <input type="radio" name={question.name} value={option} class="sr-only" />
                {option}
              </label>
            ))}
          </div>
        </fieldset>
      )),
    )
  }

  <!-- submit: en el paso 1 valida y avanza (Enter en una opción también) -->
  <button type="submit" data-continue class:list={[primary, "mt-1"]}>
    Continuar
  </button>

  <!-- Paso 2: respuestas (un toque vuelve a las preguntas) + datos de contacto -->
  <div data-contact hidden class:list={[fadeIn, "grid gap-3"]}>
    <div data-summary class="mb-2 flex flex-wrap gap-1.5"></div>
    <template data-summary-chip>
      <button
        type="button"
        class="flex cursor-pointer items-center gap-1.5 rounded-full bg-neutral-100 py-3 pr-3 pl-4 text-sm font-medium lg:py-1.5 lg:pr-2.5 lg:pl-3 lg:text-xs text-neutral-700 transition-colors hover:bg-neutral-200"
      >
        <span data-summary-text></span>
        <Pencil class="size-3.5 text-neutral-400 lg:size-3" />
      </button>
    </template>

    <input
      name="name"
      type="text"
      autocomplete="name"
      enterkeyhint="next"
      placeholder="Tu nombre"
      aria-label="Nombre"
      class={field}
    />
    <input
      name="email"
      type="email"
      autocomplete="email"
      enterkeyhint="next"
      placeholder="tu@email.com"
      aria-label="Email"
      class={field}
    />
    <div class="relative flex items-center">
      <span
        class="pointer-events-none absolute left-4 select-none text-base text-neutral-500 lg:text-sm"
        >+56 9</span
      >
      <input
        name="phone"
        type="tel"
        inputmode="numeric"
        autocomplete="tel-national"
        enterkeyhint="send"
        placeholder="1234 5678"
        aria-label="Teléfono"
        class={`${field} pl-15 lg:pl-14`}
      />
    </div>
    <p class="-mt-1 px-1 text-xs text-neutral-500">
      Basta con un email o un teléfono.
    </p>
    <button type="submit" data-submit class:list={[primary, "mt-1"]}>
      Quiero que me contacten
    </button>
  </div>

  <p data-status role="status" aria-live="polite" class="-mt-2 hidden text-center text-xs">
  </p>
</form>

<script>
  import { chileanMobileDigits } from "@/lib/contact";

  const GENERIC_ERROR = "Ocurrió un error. Intenta nuevamente.";

  document
    .querySelectorAll<HTMLFormElement>("[data-request-contact]")
    .forEach((form) => {
      const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
      const next = form.querySelector<HTMLButtonElement>("[data-continue]")!;
      const status = form.querySelector<HTMLElement>("[data-status]")!;
      const contact = form.querySelector<HTMLElement>("[data-contact]")!;
      const summary = form.querySelector<HTMLElement>("[data-summary]")!;
      const chipTemplate = form.querySelector<HTMLTemplateElement>("[data-summary-chip]")!;
      const email = form.elements.namedItem("email") as HTMLInputElement;
      const name = form.elements.namedItem("name") as HTMLInputElement;
      const phone = form.elements.namedItem("phone") as HTMLInputElement;
      const submitLabel = submit.textContent;
      const questions = [
        ...form.querySelectorAll<HTMLFieldSetElement>("fieldset[data-question]"),
      ];

      const show = (text: string, ok: boolean) => {
        status.textContent = text;
        status.classList.remove("hidden");
        status.classList.toggle("text-green-700", ok);
        status.classList.toggle("text-red-600", !ok);
      };
      const clear = () => status.classList.add("hidden");

      // Las preguntas de la otra operación quedan disabled: fuera del
      // FormData y de la validación.
      const active = () => questions.filter((f) => !f.disabled);
      const answer = (f: HTMLFieldSetElement) =>
        f.querySelector<HTMLInputElement>("input:checked");

      // Solo movemos el foco si se navega con teclado (en mobile abriría el teclado)
      let keyboard = false;
      form.addEventListener("pointerdown", () => (keyboard = false));
      form.addEventListener("keydown", (event) => {
        keyboard = true;
        // Enter en un campo con enterkeyhint="next" pasa al siguiente en vez de enviar
        const input = event.target as HTMLInputElement;
        if (event.key === "Enter" && input.enterKeyHint === "next") {
          event.preventDefault();
          const fields = [name, email, phone];
          fields[fields.indexOf(input) + 1]?.focus();
        }
      });

      // El autocompletado entrega "9 1234 5678" (o con +56): lo dejamos en los
      // 8 dígitos que van después del prefijo fijo "+56 9".
      phone.addEventListener("change", () => {
        const digits = chileanMobileDigits(phone.value);
        if (digits.length === 8) phone.value = `${digits.slice(0, 4)} ${digits.slice(4)}`;
      });

      // --- Pasos -----------------------------------------------------------
      let step: 1 | 2 = 1;

      const render = () => {
        questions.forEach((f) => (f.hidden = step !== 1 || f.disabled));
        next.hidden = step !== 1;
        contact.hidden = step !== 2;

        summary.replaceChildren(
          ...(step === 2 ? active() : []).map((f) => {
            const chip = chipTemplate.content.firstElementChild!.cloneNode(true) as HTMLButtonElement;
            const text = answer(f)!.closest("label")!.textContent!.trim();
            const label = f.querySelector("legend")!.textContent!.trim();
            chip.querySelector("[data-summary-text]")!.textContent = text;
            chip.setAttribute("aria-label", `Cambiar respuesta a "${label}": ${text}`);
            chip.addEventListener("click", () => goTo(1, answer(f)));
            return chip;
          }),
        );
      };

      const goTo = (target: 1 | 2, focus?: HTMLElement | null) => {
        step = target;
        clear();
        render();
        if (keyboard) focus?.focus();
      };

      // Elegir qué busca (comprar/arrendar) muestra las preguntas de esa operación
      form.addEventListener("change", (event) => {
        const input = event.target as HTMLInputElement;
        if (input.type !== "radio") return;
        if (input.name === "operation") {
          const operation = input.value;
          questions.forEach((f) => {
            if (f.dataset.operation) f.disabled = f.dataset.operation !== operation;
          });
        }
        clear();
        render();
      });

      // --- Envío (paso 1: continuar · paso 2: enviar) -----------------------
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        clear();

        if (step === 1) {
          const unanswered = active().find((f) => !answer(f));
          if (unanswered) {
            unanswered.querySelector("input")?.focus();
            return show("Responde todas las preguntas.", false);
          }
          return goTo(2, name);
        }

        const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
        const phoneDigits = chileanMobileDigits(data.phone);

        if (!data.name.trim() || (!data.email.trim() && !phoneDigits)) {
          return show("Completa tu nombre y un email o teléfono.", false);
        }
        if (!email.checkValidity()) {
          return show("El email no es válido.", false);
        }
        if (phoneDigits && phoneDigits.length !== 8) {
          return show("El teléfono debe tener 8 dígitos.", false);
        }

        submit.disabled = true;
        submit.textContent = "Enviando…";

        try {
          const res = await fetch("/api/lead", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const body = await res.json().catch(() => ({}));

          if (res.ok) {
            // Enviado: el formulario se reemplaza por el mensaje de éxito
            contact.hidden = true;
            show("¡Listo! Un ejecutivo te contactará pronto.", true);
            status.classList.replace("text-xs", "text-sm");
          } else {
            show(body.error ?? GENERIC_ERROR, false);
          }
        } catch {
          show(GENERIC_ERROR, false);
        } finally {
          submit.disabled = false;
          submit.textContent = submitLabel;
        }
      });
    });
</script>
