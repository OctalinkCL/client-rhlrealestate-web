---
import type { Property } from "../../lib/easybroker";
import { XIcon } from "@lucide/astro";
import Gallery from "./Gallery.astro";

interface Props {
  images: Property["property_images"];
}

const { images } = Astro.props;
---

<div>
  <div
    class="lg:grid grid-cols-1 lg:grid-cols-4 grid-rows-2 gap-4 lg:h-[540px]"
  >
    <div
      class="bg-neutral-200 col-span-2 row-span-2 relative overflow-hidden rounded-xl"
    >
      <img
        src={images[0].url}
        alt="bento_image"
        class="object-cover w-full h-full"
      />
    </div>
    <div
      class="bg-neutral-200 col-span-2 row-span-1 relative overflow-hidden rounded-xl"
    >
      <img
        src={images[1].url}
        alt="bento_image"
        class="object-cover w-full h-full"
      />
    </div>
    <div
      class="bg-neutral-200 col-span-1 row-span-1 relative overflow-hidden rounded-xl"
    >
      <img
        src={images[2].url}
        alt="bento_image"
        class="object-cover w-full h-full"
      />
    </div>
    <div
      class="bg-neutral-200 col-span-1 row-span-1 relative overflow-hidden rounded-xl"
    >
      <div class="absolute inset-0 bg-primary/80 flex items-end justify-end">
        <button
          data-open-gallery
          class="bg-white/90 m-4 rounded-md p-2 text-xs font-medium cursor-pointer"
        >
          Ver todas las imagenes
        </button>
      </div>
      <img
        src={images[3].url}
        alt="bento_image"
        class="object-cover w-full h-full"
      />
    </div>
  </div>

  <!-- Modal Lightbox -->
  <div
    id="gallery-modal"
    style="display:none"
    class="fixed inset-0 bg-black/90 z-50 flex flex-col items-center justify-center"
  >
    <button
      id="gallery-modal-close"
      class="absolute top-4 right-4 text-white bg-white/10 hover:bg-white/20 rounded-full p-2 cursor-pointer"
      aria-label="Cerrar"
    >
      <XIcon class="w-6 h-6" />
    </button>
    <div class="w-full max-w-4xl px-4">
      <Gallery images={images} id="gallery-modal-splide" />
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById("gallery-modal")!;
  const openBtn = document.querySelector("[data-open-gallery]")!;
  const closeBtn = document.getElementById("gallery-modal-close")!;
  const close = () => {
    modal.style.display = "none";
    document.body.style.overflow = "";
  };

  openBtn.addEventListener("click", () => {
    modal.style.display = "flex";
    document.body.style.overflow = "hidden";
  });

  closeBtn.addEventListener("click", close);
  modal.addEventListener("click", (e) => {
    if (e.target === modal) close();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
</script>
