---
import type { Property } from "../../lib/easybroker";
interface Props {
  images: Property["property_images"];
}
const { images } = Astro.props;
---

<div id="gallery-splide" class="splide rounded overflow-hidden">
  <div class="splide__track">
    <ul class="splide__list">
      {
        images.map((img) => (
          <li class="splide__slide">
            <img src={img.url} alt="" class="w-full aspect-4/3 object-cover" />
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import Splide from "@splidejs/splide";
  new Splide("#gallery-splide", {
    type: "loop",
    pagination: true,
    arrows: true,
  }).mount();
</script>
