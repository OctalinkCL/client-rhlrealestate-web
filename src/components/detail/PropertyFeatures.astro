---
import { Check } from "@lucide/astro";
import type { PropertyFeature } from "@/lib/easybroker";

interface Props {
  features?: PropertyFeature[] | null;
}

// Agrupamos por la categoría que trae EasyBroker (Exterior, General, …),
// conservando el orden en que vienen.
const groups = new Map<string, string[]>();
for (const { name, category } of Astro.props.features ?? []) {
  const key = category || "Otras";
  groups.set(key, [...(groups.get(key) ?? []), name]);
}
---

{
  groups.size > 0 && (
    <section>
      <h2 class="text-xl font-semibold">Características</h2>
      <div class="mt-4 grid gap-6 sm:grid-cols-2">
        {[...groups].map(([category, names]) => (
          <div>
            <h3 class="text-xs font-medium uppercase tracking-wide text-neutral-500">
              {category}
            </h3>
            <ul class="mt-3 grid gap-2 text-sm">
              {names.map((name) => (
                <li class="flex items-start gap-2">
                  <Check size={16} class="mt-0.5 shrink-0 text-neutral-900" />
                  {name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  )
}
