---
import type { EBLocation } from "../lib/easybroker";

interface Props {
  localities: EBLocation[];
  operacion?: string;
  tipo?: string;
  ubicacion?: string;
}

const { localities, operacion = "", tipo = "", ubicacion = "" } = Astro.props;

const TIPOS = [
  "Casa",
  "Departamento",
  "Cabaña",
  "Comercial",
  "Edificio",
  "Estacionamiento",
  "Oficina",
  "Terreno",
];
---

<form action="/propiedades" method="GET" class="grid gap-3 lg:grid-cols-7">
  <div class="lg:col-span-2 col-span-7">
    <select name="operacion" id="operacion" class="input-field">
      <option value="sale" selected={operacion === "" || operacion === "sale"}
        >Venta</option
      >
      <option value="rental" selected={operacion === "rental"}>Arriendo</option>
    </select>
  </div>

  <div class="lg:col-span-2 col-span-7">
    <select name="tipo" id="tipo" class="input-field">
      <option value="">Todos</option>
      {
        TIPOS.map((t) => (
          <option value={t} selected={t === tipo}>
            {t}
          </option>
        ))
      }
    </select>
  </div>

  <div class="lg:col-span-2 col-span-7">
    <select name="ubicacion" id="ubicacion" class="input-field">
      <option value="">Todas</option>
      {
        localities.map((loc) => (
          <>
            <option value={loc.name} selected={loc.name === ubicacion}>
              {loc.name}
            </option>
            {loc.localities?.map((child) => (
              <option value={child.name} selected={child.name === ubicacion}>
                &nbsp;&nbsp;{child.name}
              </option>
            ))}
          </>
        ))
      }
    </select>
  </div>

  <button
    class="bg-blue-950 h-[40px] rounded font-medium text-white lg:col-span-1 col-span-7 w-full"
    type="submit">Buscar</button
  >
</form>
