  >
    <div id="exclusive-loading">
      <p>Buscando exclusivas para ti...</p>
    </div>
    <ul id="exclusive-list" style="display:none"></ul>
  </div>
</section>

<script>
  // --- MOCK para desarrollo — reemplazar por fetch real cuando el UI esté listo ---
  const MOCK_PROPERTIES = [
    {
      public_id: "EB-AA0001",
      title: "Casa moderna en Concepción",
      property_type: "Casa",
      location: "Las Higueras, Concepción, Biobío",
      price: "UF 4.500",
    },
    {
      public_id: "EB-AA0002",
      title: "Departamento con vista al mar",
      property_type: "Departamento",
      location: "Pelluco, Puerto Montt, Los Lagos",
      price: "UF 3.200",
    },
    {
      public_id: "EB-AA0003",
      title: "Casa en condominio Brisas del Sol",
      property_type: "Casa",
      location: "Brisas del Sol, Talcahuano, Biobío",
      price: "$1.200.000 CLP",
    },
    {
      public_id: "EB-AA0004",
      title: "Departamento en Barrio Universitario",
      property_type: "Departamento",
      location: "Centro, Concepción, Biobío",
      price: "UF 2.100",
    },
    {
      public_id: "EB-AA0005",
      title: "Casa remodelada con quincho",
      property_type: "Casa",
      location: "San Pedro de la Paz, Biobío",
      price: "UF 5.800",
    },
    {
      public_id: "EB-AA0006",
      title: "Oficina en edificio corporativo",
      property_type: "Oficina",
      location: "Centro, Concepción, Biobío",
      price: "UF 1.800",
    },
    {
