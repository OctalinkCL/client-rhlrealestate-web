      property_type: "Departamento",
      location: "Mirador, Concepción, Biobío",
      price: "UF 6.200",
    },
  ];

  function renderProperties(
    properties: {
      public_id: string;
      title: string;
      property_type: string;
      location: string;
      price: string;
    }[],
    loading: HTMLElement | null,
    list: HTMLElement | null,
  ) {
    if (loading) loading.style.display = "none";
    if (list) {
      list.style.display = "";
      list.innerHTML = properties
        .map(
          (p) =>
            `<li>${p.public_id} — ${p.title} | ${p.property_type} | ${p.location} | ${p.price}</li>`,
        )
        .join("");
    }
  }

  const loading = document.getElementById("exclusive-loading");
  const list = document.getElementById("exclusive-list");
  renderProperties(MOCK_PROPERTIES, loading, list);
</script>
