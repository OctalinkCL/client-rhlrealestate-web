---
import PageHeader from "../PageHeader.astro";
import { getPropertiesFeatures } from "../../lib/easybroker";
import PropertyCard from "../PropertyCard.astro";

const response = await getPropertiesFeatures();
const properties = response.content;
---

<section class="py-10 lg:py-20">
  <div class="container mx-auto px-4 lg:px-0">
    <PageHeader
      tagLabel="Destacadas"
      title="Nuestra Oferta"
      subtitle="Encuentra la propiedad perfecta para ti. Explora nuestra selección de propiedades en venta y alquiler."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {properties.map((property) => <PropertyCard property={property} />)}
    </div>
  </div>
</section>
