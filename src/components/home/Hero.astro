---
import Buscador from "../Buscador.astro";
import { getLocations } from "../../lib/easybroker";
import { setCacheHeaders } from "../../lib/cache";

setCacheHeaders(Astro.response);
const { localities } = await getLocations();
const videoUrl = "https://estatehubvideo.b-cdn.net/Untitled%20design%20(3).mp4";
const videoPoster =
  "https://framerusercontent.com/images/oFTAozKElqxglywix9lJ2dKkjm8.webp?width=4320&height=2160";
---

<section class="home-hero">
  <!-- Container -->
  <div class="home-hero__container">
    <div class="home-hero__container--contents">
      <!-- Video & Image Background -->
      <video
        src={videoUrl}
        poster={videoPoster}
        loop
        playsinline
        muted
        class="home-hero__container--video"></video>
    </div>
  </div>
  <!-- Cover -->
  <div class="home-hero__cover">
    <!-- Inner -->
    <div class="home-hero__cover--inner">
      <!-- Title -->
      <div class="home-hero__cover--title">
        <div class="home-hero__cover--badge">
          <div>Rated 4.7/5</div>
          <span>Concepción #1 Realtors</span>
        </div>
        <h1 class="home-hero__cover--title--h1">
          La manera más segura de vender tu propiedad
        </h1>
      </div>
      <!-- Detail -->
      <div class="home-hero__cover--detail">
        <p>
          Find exceptional properties curated for contemporary living, blending
          refined design, desirable neighborhoods, and lasting investment value.
        </p>
        <div class="home-hero__cover--detail--searcher">
          <Buscador {localities} />
        </div>
      </div>
    </div>
  </div>
  <!-- Linear -->
  <div></div>
</section>

<script>
  // Autoplay fix for mobile devices
  const isMobile = window.innerWidth < 768;
  const video = document.querySelector("video") as HTMLVideoElement;
  video.autoplay = true;
</script>
