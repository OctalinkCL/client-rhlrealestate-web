---
import { Image } from "astro:assets";
import HeroImg from "../../assets/home_hero.webp";

import Buscador from "../Buscador.astro";
import { getLocations } from "../../lib/easybroker";
import { setCacheHeaders } from "../../lib/cache";

setCacheHeaders(Astro.response);
const { localities } = await getLocations();
---

<!-- Hero -->
<section
  class="flex-none flex-row items-center w-full h-screen relarive max-h-[1200px] place-content-center overflow-hidden"
>
  <!-- Container -->
  <div class="z-0 absolute inset-0 flex">
    <div class="contents">
      <!-- <img
        src="/img/home_hero.webp"
        alt="RHL Real Estate"
        class="size-full block object-cover"
      /> -->
      <Image
        src={HeroImg}
        alt="RHL Real Estate"
        class="size-full block object-cover"
      />
    </div>
  </div>

  <!-- Cover -->
  <div
    class="bg-primary/45 z-10 h-full flex flex-1 relative overflow-hidden pt-28 pb-8 px-4 | lg:pt-40 lg:pb-10 lg:px-0"
  >
    <!-- Inner -->
    <div
      class="container mx-auto relative flex flex-col items-start place-content-between"
    >
      <!-- Title -->
      <div
        class="flex flex-col flex-none items-start gap-4 w-full overflow-hidden max-w-2xl"
      >
        <!-- Badge -->
        <div
          class="border border-white/30 rounded-full p-1 flex items-center text-xs lg:text-sm gap-3"
        >
          <div class="bg-white text-black rounded-full px-3 py-1">Modo RHL</div>
          <span class="text-white pr-3">Ventas · Arriendo · Inversión</span>
        </div>
        <!-- H1 -->
        <h1 class="text-white font-display leading-none text-4xl | lg:text-7xl">
          La manera más segura de vender tu propiedad
        </h1>
      </div>
      <!-- Detail -->
      <div class="border-t border-white/30 gap-9 w-full grid pt-6 | lg:gap-12">
        <!-- Text -->
        <p class="text-white text-sm | lg:max-w-lg lg:text-lg lg:font-light">
          En RHL Real Estate te acompañamos con un equipo de brokers, un proceso
          claro y el Modo RHL — nuestra forma de cuidar cada paso, desde la
          vitrina hasta el cierre.
        </p>
        <!-- Finder -->
        <div class="bg-white/10 rounded-xl backdrop-blur lg:rounded-full p-2">
          <div class="bg-white rounded-lg p-4 lg:rounded-full">
            <Buscador {localities} />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- @apply w-full bg-[#000914]/60 backdrop-blur-lg p-4 rounded-lg; -->

  <!-- Linear -->
  <div
    class="z-0 absolute inset-0 overflow-hidden h-screen bg-linear-to-r lg:from-40% from-primary/75 to-black/0"
  >
  </div>
</section>
