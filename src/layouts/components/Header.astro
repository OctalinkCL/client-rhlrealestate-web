---
import { Menu } from "@lucide/astro";

const navigation = [
  { title: "Inicio", url: "/" },
  { title: "Propiedades", url: "/propiedades" },
  { title: "Nosotros", url: "/nosotros" },
  { title: "Contacto", url: "/contacto" },
];
---

<header class="bg-rhl-primary sticky top-0 z-10 text-white">
  <!-- Header -->
  <div class="wrap flex items-center justify-between py-4">
    <!-- Logo -->
    <img src="logo_rhl_white.svg" alt="RHL Real Estate" class="w-54 lg:w-80" />

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex gap-3">
      {navigation.map((item) => <a href={item.url}>{item.title}</a>)}
    </nav>

    <!-- Mobile Button -->
    <button id="button" class="md:hidden border border-white/30 rounded p-2">
      <Menu size={21} />
    </button>
  </div>

  <!-- Mobile Navigation -->
  <nav id="mobile-navigation" class="hidden lg:hidden px-4">
    <div class="grid gap-2 pb-5">
      {
        navigation.map((item) => (
          <a
            href={item.url}
            class="bg-white/10 rounded px-3 py-2 font-semibold"
          >
            {item.title}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById("button");
  const mobileNavigation = document.getElementById("mobile-navigation");

  button?.addEventListener("click", () => {
    const isHidden = mobileNavigation?.classList.contains("hidden");
    mobileNavigation?.classList.toggle("hidden", !isHidden);
  });
</script>
