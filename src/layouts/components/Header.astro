---
const isHome = Astro.url.pathname === "/";
---

<header
  data-home={isHome}
  class:list={["fixed top-0 w-full z-10 group", !isHome && "bg-white"]}
>
  <!-- Header -->
  <nav class="container mx-auto px-4 lg:px-0">
    <div class="flex items-center justify-between lg:grid lg:grid-cols-5">
      <!-- Logo -->
      <div class="lg:col-span-1">
        <span class="group-[.bg-white]:text-red-500">Logo</span>
      </div>
      <!-- Menu -->
      <div class="lg:col-span-3 text-center hidden lg:block">Menu</div>
      <!-- Actions -->
      <div class="lg:col-span-1 text-right">
        <button class="hidden lg:inline-block">Contact</button>
        <button class="lg:hidden">Mobile</button>
      </div>
    </div>
  </nav>

  <!-- Mobile: Navigation -->
  <nav class="overflow-hidden lg:hidden" style="height:0">HOLA_MOBILE</nav>
</header>

<script>
  const header = document.querySelector("header");
  const isHome = header?.dataset.home === "true";

  if (isHome) {
    window.addEventListener("scroll", () => {
      header?.classList.toggle("bg-white", window.scrollY > 50);
    });
  }
</script>
